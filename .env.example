# Task Inbox — copy to .env.local for a laptop. Real production values live in your host's env (Cloud Run, Docker, …), never in git.

# What the inbox calls itself (title bar, exports, hand-over notes).
INBOX_NAME=Task Inbox
# The systems / areas a task can be filed under: key:Label pairs, comma separated. Keys are lower-case [a-z0-9-].
INBOX_SYSTEMS=web:เว็บไซต์,backend:ระบบหลังบ้าน,mobile:แอปมือถือ,other:อื่น ๆ

# Laptop: JSON store in .data/inbox-db.json, files in .data/files, /setup opens with the code "setup".
INBOX_DEV_MODE=true
# INBOX_DATA_FILE=.data/inbox-db.json
# INBOX_FILES_DIR=.data/files

# Production (all required):
# SESSION_SECRET=            # long random string; signs the login cookie (openssl rand -hex 32)
# SETUP_CODE=                # opens /setup until the first admin exists; remove afterwards
# FIREBASE_PROJECT_ID=       # GCP project that holds the Firestore database
# FIRESTORE_DATABASE_ID=     # optional; omit for the project's default database
# GCS_BUCKET=                # bucket for attachments
# PUBLIC_BASE_URL=https://inbox.example.com

# DATA_STORE=memory|firestore overrides the store choice (default: memory in dev mode, firestore otherwise).
